# TestNet settings for arcron-rain (algonode public API).
# Copy to .env.testnet and fill in. .env.testnet is gitignored; this is not.
ALGOD_SERVER=https://testnet-api.algonode.cloud
INDEXER_SERVER=https://testnet-idx.algonode.cloud

# Throwaway TestNet deployer mnemonic (25 words). NEVER use a real/mainnet account.
# Needed by `fledge run deploy-testnet`, `rain-bot` and `rain-one-draw`.
# DEPLOYER_MNEMONIC="word1 word2 ... word25"

# The rain hub. Nothing here defaults to one: no hub of this repository's own
# is deployed yet, and the hub that ran under arcron is immutable and
# superseded, so the scripts refuse to start rather than guess.
# RAIN_APP_ID=

# The Arcron keeper registry that fires `draw()`. Only needed to override the
# default in scripts/rain_testnet_deploy.py.
# ARCRON_KEEPER_APP_ID=769891898
